#!/bin/sh
# Keep tunnel authentication/state under {{ dcmcp_home }}.
# Run Desktop Commander with the existing Linux account's home and settings.
export HOME={{ dcmcp_account_home | quote }}
export USER={{ dcmcp_user | quote }}
export LOGNAME={{ dcmcp_user | quote }}
if [ -d /run/user/{{ dcmcp_uid }} ]; then
    export XDG_RUNTIME_DIR=/run/user/{{ dcmcp_uid }}
    if [ -S /run/user/{{ dcmcp_uid }}/bus ]; then
        export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{{ dcmcp_uid }}/bus
    fi
fi
# Only MCP JSON-RPC frames may go to stdout. exec preserves pipes and signals.
exec {{ dcmcp_prefix }}/current/node/bin/node {{ dcmcp_prefix }}/current/mcp/dist/index.js --no-onboarding
