#!/bin/sh
# Vendor-neutral MCP stdio entrypoint. Stdout is reserved for MCP JSON-RPC.
# Refuse cross-account execution rather than inheriting another user's credentials.
if [ "$(/usr/bin/id -u)" != "{{ dcmcp_uid }}" ]; then
    echo "MCP child must run as the selected runtime account." >&2
    exit 78
fi
# Use the existing account's home and Desktop Commander settings.
export HOME={{ dcmcp_account_home | quote }}
export USER={{ dcmcp_user | quote }}
export LOGNAME={{ dcmcp_user | quote }}
export NODE_ENV=production
if [ -d /run/user/{{ dcmcp_uid }} ]; then
    export XDG_RUNTIME_DIR=/run/user/{{ dcmcp_uid }}
    if [ -S /run/user/{{ dcmcp_uid }}/bus ]; then
        export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{{ dcmcp_uid }}/bus
    fi
fi
# Only MCP JSON-RPC frames may go to stdout. exec preserves pipes and signals.
exec {{ dcmcp_current }}/node/bin/node {{ dcmcp_current }}/mcp/dist/index.js --no-onboarding
